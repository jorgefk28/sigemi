# ---------------------------------------------------------------------------
# SIGEMI - environment configuration template
# Copy this file to `.env` (same directory) and adjust the values.
# The `.env` file is git-ignored; never commit real secrets.
# ---------------------------------------------------------------------------

APP_ENV=dev
APP_NAME=SIGEMI
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Database (host port 5433 is mapped by docker-compose to avoid clashing
# with a locally installed PostgreSQL on 5432)
POSTGRES_DB=sigemi
POSTGRES_USER=sigemi
POSTGRES_PASSWORD=sigemi
DATABASE_URL=postgresql+psycopg://sigemi:sigemi@localhost:5433/sigemi

# Broker / cache
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OTP (RNF-02: 7 days TTL)
OTP_TTL_DAYS=7

# WhatsApp Cloud API (RF-07 / manifest section 3)
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
